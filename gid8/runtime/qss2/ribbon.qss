WToolButton {
    background-color: #f7f3f7;
    font-size: 12px;
    border-radius: 5px;
    /*
    margin: 0px;
    padding: 0px;

    
    margin: 3px;
    padding: 3px;
    padding-right: 20px;
    */
}

QToolButton::menu-indicator {
    image: url(/chevron-down-svgrepo-com.svg); 
    subcontrol-origin: padding;
    subcontrol-position: right center; /* Располагаем индикатор справа, по центру */
    width: 20px;
    height: 20px;
}


WToolButton:hover {
    background-color: #cdebff;
}

WToolButton:checked  {
     
    background-color: #cdebff; 

