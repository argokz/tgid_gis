QTabWidget {
    background-color: #fff;
    background:#fff;
    border: 10px solid red;
}

QTabWidget::pane {
    border-top: 1px solid rgb(200, 200, 200); /* Серый цвет бордера */
    position: absolute;
    top: -1px;
    background: #e1e0df;
    background-color: #e1e0df;
}

QTabWidget QTabBar {
    background-color: #e1e0df;
}

QTabWidget QTabBar::tab{
    background: #e1e0df;
    background-color: #e1e0df;
    border: none;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 20px; 
    color: #000;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
}

QTabWidget QTabBar::tab:hover{
    font-weight: 600;
    box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
}

QTabWidget QTabBar::tab:selected{
    color: #000;
    font-weight: 600;
    border-bottom: 2px solid #000;
    background: #f7f3f7 ;
    background-color: #f7f3f7 ;
    border-top-left-radius: 5px; 
    border-top-right-radius: 5px;
    box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
}

