
QToolTip {
    border: 2px solid darkkhaki;
    white-space: normal;
    padding: 5px;
    border-radius: 3px;
    opacity: 200;
    font-size: 12px;
}


QHeaderView1::section {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #616161, stop: 0.5 #505050,
                                      stop: 0.6 #434343, stop:1 #656565);
    color: white;
    padding-left: 4px;
    border: 1px solid #6c6c6c;
}

QHeaderView1::section:checked
{
    background-color: red;
}


QPushButton[class='ok'] {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 #66cc66, stop:1 #4CAF50); /* Градиент сверху вниз */
    color: white;                    /* Белый цвет текста */
    border: 1px solid #388e3c;       /* Зеленая граница */
}

QPushButton[class='ok']:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 #57a957, stop:1 #388e3c); /* Темный градиент при наведении */
}

QPushButton[class='ok']:pressed {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 #4CAF50, stop:1 #388e3c); /* Градиент для эффекта нажатия */
}


