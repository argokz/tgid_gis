#myRibbonButtonGroup {
      background-color: #FA0000;
      border: 1px solid #000;
}


QMenuBar { 
    background-color: #f7f3f7; 
    color: #000; 
}

QMenuBar::item:selected { background-color: #CDEBFF; }
QMenuBar::item:pressed { background-color: #CDEBFF; }
QMenuBar::icon { width: 0px; padding-left: 0px; }

QMenu { background-color: #f7f3f7; color: #000; }

QMenu::item:selected { background-color: #CDEBFF; }

QMenu::item:pressed { background-color: #CDEBFF; }

QMenu::item:disabled {
    color: gray; /* Цвет текста */
    background-color: transparent; /* Фон отключённого элемента */
}


QToolBar {
   background: #dadada;
   height: 30px;
   padding: 1px;
   spacing: 3px; /* spacing between items in the tool bar */
}

QToolBar::handle {
    image: url(handle.svg);
}

QToolBar QLineEdit {
   border-radius: 4px;
   font-size: 14px;
   border: none;
}

QToolBar QComboBox {
   font-size: 14px;
}

