    background-color: #616161;
    color: #ffffff;
    font-size: 12px;
    padding: 4px;
    border-radius: 3px;
}
*/

QToolTip {
    border: 2px solid darkkhaki;
    white-space: normal;
    padding: 5px;
    border-radius: 3px;
    opacity: 200;
    font-size: 14px;
}


QHeaderView::section {
    height: 10px;
    color: black;
    background-color: white;
/*    background-color: #bdbdbd;*/

    padding-left: 4px;
    border: 1px solid rgba(0, 0, 0, 0.2);;
}

QHeaderView::section:checked
{
/*    background-color: red;*/
}

/* style the sort indicator */
QHeaderView::down-arrow {
    image: url(down_arrow.png);
}

QHeaderView::up-arrow {
    image: url(up_arrow.png);
}

/*[class='property_ok']*/

QPushButton {
    background-color: #f0f0f0;       /* Светло-серый фон */
    color: black;                    /* Черный текст */
    border: 1px solid #b0b0b0;       /* Легкая серая рамка */
    padding: 4px 8px;               /* Отступы */
    border-radius: 4px;              /* Легкое скругление углов */
}

QPushButton:hover {
    background-color: #e6e6e6;       /* Немного темнее при наведении */
}

QPushButton:pressed {
    background-color: #dcdcdc;       /* Еще темнее при нажатии */
    padding-left: 6px;
    padding-top: 6px;                /* Легкий эффект вдавливания */
}

QPushButton:disabled {
    background-color: #f5f5f5;       /* Серый цвет для неактивного состояния */
    color: #a0a0a0;
}


QPushButton[dialog='property'] {
    font-size: 13px;
}


QPushButton[class='ok'] {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 #66cc66, stop:1 #4CAF50); /* Градиент сверху вниз */
    color: white;                    /* Белый цвет текста */
    border: 1px solid #388e3c;       /* Зеленая граница */
}

QPushButton[class='ok']:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 #57a957, stop:1 #388e3c); /* Темный градиент при наведении */
}

QPushButton[class='ok']:pressed {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 #4CAF50, stop:1 #388e3c); /* Градиент для эффекта нажатия */
}



