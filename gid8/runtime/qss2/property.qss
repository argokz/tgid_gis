
NullableDateEdit,
CustomDateEdit {
    border: 1px solid #BDBDBD;
    color: #212121;
    border-radius: 4px;
    margin-right: 0px;
}


QLineEdit {
    border: 1px solid #BDBDBD;
    color: #212121;
    border-radius: 4px;
    margin-right: 0px;
}


QLineEdit:hover {
    border-color: #757575;
    background-color: #FAFAFA;
}

QLineEdit[class='title'], QLineEdit[class='label'] {
    border: none;
    color: #000;
    background: transparent;
}


QLineEdit[class='number'] {
    border-right: 1px solid black;
    text-align: center;
    width: 20px;
    color: blue;
    background: transparent;
}


QLineEdit[class='title']:hover, QLineEdit[class='label']:hover, QLineEdit[class='number']:hover,
QLineEdit[class='title']:focus, QLineEdit[class='label']:focus, QLineEdit[class='number']:focus {
    background: transparent;
    border: none;
    color: #000;
}


QComboBox {
    border: 1px solid #BDBDBD;
    color: #212121;
    border-radius: 4px;
}

QComboBox:hover {
    border-color: #757575;
    background-color: #FAFAFA;
}


QTreeWidget {
    background-color: #ffffff;
}

QTreeWidget::item {
    background-color: #ffffff;
    border-top: 1px solid #E0E0E0;
    padding-top: 2px;
    padding-bottom: 2px;

}

QTreeWidget::item:selected {
    background-color: #E3F2FD; 
    color: #000;
}

QTreeWidget::item:hover {
    background-color: #F1F8FF; 
}

QScrollBar:vertical {
    border: none;
    background: #f7f7f7;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

/*
