QMainWindow {
    background-color: #FFFFFF;
}

QDialog {
    background-color: #FFFFFF;
}

QColorDialog {
    background-color: #FFFFFF;
}

QTextEdit {
    background-color: #FFFFFF;
    color: #a9b7c6;
}

QPlainTextEdit {
    selection-background-color: #007b50;
    background-color: #FFFFFF;
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-width: 1px;
    color: #a9b7c6;
}

QPushButton {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-width: 1px;
    border-style: solid;
    color: #a9b7c6;
    padding: 2px;
    background-color: #FFFFFF;
}

QPushButton::default {
    border-style: inset;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: #04b97f;
    border-width: 1px;
    color: #a9b7c6;
    padding: 2px;
    background-color: #FFFFFF;
}

QToolButton {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: #04b97f;
    border-bottom-width: 1px;
    border-style: solid;
    color: #a9b7c6;
    padding: 2px;
    background-color: #FFFFFF;
}

QToolButton:hover {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: #37efba;
    border-bottom-width: 2px;
    border-style: solid;
    color: #000000;
    padding-bottom: 1px;
    background-color: #FFFFFF;
}

QPushButton:hover {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: #37efba;
    border-bottom-width: 1px;
    border-style: solid;
    color: #000000;
    padding-bottom: 2px;
    background-color: #FFFFFF;
}

QPushButton:pressed {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: #37efba;
    border-bottom-width: 2px;
    border-style: solid;
    color: #37efba;
    padding-bottom: 1px;
    background-color: #FFFFFF;
}

QPushButton:disabled {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: #808086;
    border-bottom-width: 2px;
    border-style: solid;
    color: #808086;
    padding-bottom: 1px;
    background-color: #FFFFFF;
}

QLineEdit {
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(58, 58, 58);
    border-style: inset;
    padding: 0 8px;
    color: #a9b7c6;
    background: #FFFFFF;
    selection-background-color: #007b50;
    selection-color: #000000;
}

QLabel {
    color: #a9b7c6;
}

QLCDNumber {
    color: #37e6b4;
}

QProgressBar {
    text-align: center;
    color: rgb(240, 240, 240);
    border-width: 1px;
    border-radius: 10px;
    border-color: rgb(58, 58, 58);
    border-style: inset;
    background-color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #04b97f;
    border-radius: 5px;
}

QMenuBar {
    background-color: #FFFFFF;
}

QMenuBar::item {
    color: #a9b7c6;
    spacing: 3px;
    padding: 1px 4px;
    background: #FFFFFF;
}

QMenuBar::item:selected {
    background: #FFFFFF;
    color: #000000;
}

QMenu::item:selected {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: #04b97f;
    border-bottom-color: transparent;
    border-left-width: 2px;
    color: #000000;
    padding-left: 15px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-right: 7px;
    background-color: #FFFFFF;
}

QMenu::item {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-bottom-width: 1px;
    border-style: solid;
    color: #a9b7c6;
    padding-left: 17px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-right: 7px;
    background-color: #FFFFFF;
}

QMenu {
    background-color: #FFFFFF;
}

QTabWidget {
    color: rgb(0, 0, 0);
    background-color: #FFFFFF;
}

QTabWidget::pane {
    border-color: rgb(77, 77, 77);
    background-color: #FFFFFF;
    border-style: solid;
    border-width: 1px;
    border-radius: 6px;
}

QTabBar::tab {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-bottom-width: 1px;
    border-style: solid;
    color: #808086;
    padding: 3px;
    margin-left: 3px;
    background-color: #FFFFFF;
}

QTabBar::tab:selected,
QTabBar::tab:last:selected,
QTabBar::tab:hover {
    border-style: solid;
    border-top-color: transparent;
    border-right-color: transparent;
    border-left-color: transparent;
    border-bottom-color: #04b97f;
    border-bottom-width: 2px;
    border-style: solid;
    color: #000000;
    padding-left: 3px;
    padding-bottom: 2px;
    margin-left: 3px;
    background-color: #FFFFFF;
}

QCheckBox {
    color: #a9b7c6;
    padding: 2px;
}

QCheckBox:disabled {
    color: #808086;
    padding: 2px;
}

QCheckBox:hover {
    border-radius: 4px;
    border-style: solid;
    padding-left: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-top: 1px;
    border-width: 1px;
    border-color: rgb(87, 97, 106);
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    height: 10px;
    width: 10px;
    border-style: solid;
    border-width: 1px;
    border-color: #04b97f;
    color: #a9b7c6;
    background-color: #04b97f;
}

QCheckBox::indicator:unchecked {
    height: 10px;
    width: 10px;
    border-style: solid;
    border-width: 1px;
    border-color: #04b97f;
    color: #a9b7c6;
    background-color: transparent;
}

QRadioButton {
    color: #a9b7c6;
    background-color: #FFFFFF;
    padding: 1px;
}

QRadioButton::indicator:checked {
    height: 10px;
    width: 10px;
    border-style: solid;
    border-radius: 5px;
    border-width: 1px;
    border-color: #04b97f;
    color: #a9b7c6;
    background-color: #04b97f;
}

QRadioButton::indicator:!checked {
    height: 10px;
    width: 10px;
    border-style: solid;
    border-radius: 5px;
    border-width: 1px;
    border-color: #04b97f;
    color: #a9b7c6;
    background-color: transparent;
}

QStatusBar {
    color: #027f7f;
}

QSpinBox {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QDoubleSpinBox {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QTimeEdit {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QDateTimeEdit {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QDateEdit {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QComboBox {
    color: #a9b7c6;
    background: #FFFFFF;
}

QComboBox:editable {
    background: #FFFFFF;
    color: #a9b7c6;
    selection-background-color: #FFFFFF;
}

QComboBox QAbstractItemView {
    color: #a9b7c6;
    background: #FFFFFF;
    selection-color: #000000;
    selection-background-color: #FFFFFF;
}

QComboBox:!editable:on,
QComboBox::drop-down:editable:on {
    color: #a9b7c6;
    background: #FFFFFF;
}

QFontComboBox {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QToolBox {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QToolBox::tab {
    color: #a9b7c6;
    background-color: #FFFFFF;
}

QToolBox::tab:selected {
    color: #000000;
    background-color: #FFFFFF;
}

QScrollArea {
    color: #000000;
    background-color: #FFFFFF;
}

QSlider::groove:horizontal {
    height: 5px;
    background: #04b97f;
}

QSlider::groove:vertical {
    width: 5px;
    background: #04b97f;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #b4b4b4, stop: 1 #8f8f8f);
    border: 1px solid #5c5c5c;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:vertical {
    background: qlineargradient(x1: 1, y1: 1, x2: 0, y2: 0, stop: 0 #b4b4b4, stop: 1 #8f8f8f);
    border: 1px solid #5c5c5c;
    height: 14px;
    margin: 0 -5px;
    border-radius: 7px;
}

QSlider::add-page:horizontal {
    background: white;
}

QSlider::add-page:vertical {
    background: white;
}

QSlider::sub-page:horizontal {
    background: #04b97f;
}

QSlider::sub-page:vertical {
    background: #04b97f;
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QListView::indicator:disabled,
QTableView::indicator:disabled {
    background-color: #252526;
    border-color: #535355;
}

QCheckBox::indicator,
QGroupBox::indicator,
QListView::indicator,
QTableView::indicator {
    background-color: QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #565656, stop: 0.1 #525252, stop: 0.5 #4e4e4e, stop: 0.9 #4a4a4a, stop: 1 #464646);
    border-color: #686868;
    border-width: 1px;
    border-style: solid;
    border-radius: 0px;
    padding: 1px;
}

QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked,
QListView::indicator:unchecked,
QTableView::indicator:unchecked {
    image: url(:/img_test2/unchecked.png);
}

QCheckBox::indicator:unchecked:pressed,
QGroupBox::indicator:unchecked:pressed,
QListView::indicator:unchecked:pressed,
QTableView::indicator:unchecked:pressed {
    padding: 2px;
    background-color: #007ACC;
    border: none;
    image: url(:/img_test2/unchecked.png);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QListView::indicator:checked,
QTableView::indicator:checked {
    image: url(:/img_test2/checked.png);
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled,
QListView::indicator:checked:disabled,
QTableView::indicator:checked:disabled {
    image: url(:/img_test2/checked_disabled.png);
}

QCheckBox::indicator:checked:pressed,
QGroupBox::indicator:checked:pressed,
QListView::indicator:checked:pressed,
QTableView::indicator:checked:pressed {
    padding: 2px;
    background-color: #007ACC;
    border: none;
    image: url(:/img_test2/checked.png);
}

QCheckBox::indicator:indeterminate,
QListView::indicator:indeterminate,
QTableView::indicator:indeterminate {
    image: url(:/img_test2/indeterminate.png);
}

QCheckBox::indicator:indeterminate:disabled,
QListView::indicator:indeterminate:disabled,
QTableView::indicator:indeterminate:disabled {
    image: url(:/img_test2/indeterminate_disabled.png);
}

QCheckBox::indicator:indeterminate:pressed,
QListView::indicator:indeterminate:pressed,
QTableView::indicator:indeterminate:pressed {
    padding: 2px;
    background-color: #007ACC;
    border: none;
    image: url(:/img_test2/indeterminate.png);
}

QTableView {
    selection-background-color: #3F3F46;
    gridline-color: #686868;
    outline: 0;
}

QHeaderView::section,
QTableView QTableCornerButton::section {
    background-color: #252526;
    border-width: 1px;
    border-left-width: 0px;
    border-top-width: 0px;
    border-style: solid;
    border-radius: 0px;
    border-color: #3F3F46;
    padding: 2px;
}

QHeaderView::section:hover,
QTableView QTableCornerButton::section:hover {
    background-color: #3F3F46;
}

QHeaderView::section:pressed,
QTableView QTableCornerButton::section:pressed {
    background-color: #007ACC;
    border: none;
}

QHeaderView::section:disabled,
QTableView QTableCornerButton::section:disabled {
    color: #535355;
    background-color: #252526;
    border-color: #535355;
}

QHeaderView::down-arrow {
    image: url(:/img_test2/down_arrow.png);
}

QHeaderView::up-arrow {
    image: url(:/img_test2/up_arrow.png);
}

QHeaderView::down-arrow:hover {
    image: url(:/img_test2/down_arrow_hover.png);
}

QHeaderView::up-arrow:hover {
    image: url(:/img_test2/up_arrow_hover.png);
}

QHeaderView::down-arrow:disabled {
    image: url(:/img_test2/down_arrow_disabled.png);
}

QHeaderView::up-arrow:disabled {
    image: url(:/img_test2/up_arrow_disabled.png);
}