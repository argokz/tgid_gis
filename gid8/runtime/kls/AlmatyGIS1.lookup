--"uchastok","pipeSectionID","pipeSections","id","name",0,"SELECT TOP 2000000 pss.id, CONCAT(COALESCE(n1.nodeName, CONCAT(ec1.name, ' ', n1.externalNodeName)), ' - ', COALESCE(n2.nodeName, CONCAT(ec2.name, ' ', n2.externalNodeName))) name FROM pipeSections pss LEFT JOIN nodes n1 ON n1.id=pss.nodeID1 LEFT JOIN nodes n2 ON n2.id=pss.nodeID2 LEFT JOIN externalCodes ec1 ON ec1.id=n1.externalCodeID LEFT JOIN externalCodes ec2 ON ec2.id=n1.externalCodeID WHERE n1.removed=0 AND n1.fileID in ($fragments$)"
"uchastok","pipeSectionID","pipeSections","id","name",0,"SELECT TOP 2000000 pss.id, CONCAT(COALESCE(n1.nodeName, CONCAT(ec1.name, ' ', n1.externalNodeName)), ' - ', COALESCE(n2.nodeName, CONCAT(ec2.name, ' ', n2.externalNodeName))) name FROM pipeSections pss JOIN nodes n1 ON n1.id=pss.nodeID1 JOIN nodes n2 ON n2.id=pss.nodeID2 JOIN heatPipeSections hps ON hps.pipeSectionID=pss.id LEFT JOIN externalCodes ec1 ON ec1.id=n1.externalCodeID LEFT JOIN externalCodes ec2 ON ec2.id=n1.externalCodeID WHERE n1.removed=0 AND n1.fileID in ($fragments$)"





