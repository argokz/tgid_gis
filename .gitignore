# Секреты подключения — никогда не коммитим
.env
*.pgpass
config.local.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Дампы и выгрузки
*.dump
*.backup
docs/schema/*.raw.sql
docs/schema/calc_log_*.txt

# Редакторы / ОС
.vscode/
.idea/
Thumbs.db
desktop.ini

# Черновые пробы: файлы вида tools/_*.py и _*.txt создаются при разборе
# и в репозиторий не входят. Правило появилось после случая, когда
# массовый git add подхватил чужой каталог и в коммит чуть не уехал
# токен Google (gid6/dop/converter_old32/mygeo0/credentials.json).
tools/_*
*.before_stx
